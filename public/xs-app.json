{
  "welcomeFile": "index.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/api/public/(.*)$",
      "target": "/odata/v4/public/$1",
      "destination": "redstar-vm-cap-public",
      "authenticationType": "none",
      "csrfProtection": true
    },
    {
      "source": "^(.*)$",
      "target": "$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "none"
    }
  ]
}
